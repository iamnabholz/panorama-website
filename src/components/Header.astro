---
import GetButton from "./GetButton.astro";
import favicon from "../assets/favicon.svg?raw";
---

<div class="header-container">
  <header class="row-wrapper">
    <a href="/" class="row-wrapper">
      <div class="svg-icon">
        <Fragment set:html={favicon} />
      </div>
      <h1>Panorama Tab</h1>
    </a>
    <GetButton />
  </header>
</div>

<style>
  .header-container {
    height: 40vh;
  }

  header {
    position: sticky;
    top: 0;
    padding: 2rem 0;
    justify-content: space-between;
  }

  .row-wrapper {
    align-items: center;
    gap: 12px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    text-decoration: none;
  }

  .svg-icon {
    height: 64px;
    width: 64px;
  }

  h1 {
    font-size: 3rem;
  }

  @media only screen and (max-width: 640px) {
    header {
      flex-direction: column;
    }

    .header-container {
      height: 50vh;
    }

    a {
      flex-direction: column;
    }

    .svg-icon {
      height: 96px;
      width: 96px;
    }
  }
</style>
