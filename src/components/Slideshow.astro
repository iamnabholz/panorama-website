---
import { Image } from "astro:assets";
import screenshot1 from "../assets/screenshots/screenshot-1.webp";
import screenshot2 from "../assets/screenshots/screenshot-2.webp";
import screenshot3 from "../assets/screenshots/screenshot-3.webp";
import screenshot4 from "../assets/screenshots/screenshot-4.webp";

const slides = [screenshot1, screenshot2, screenshot3, screenshot4];
---

<div
    class="showcase"
    style={`aspect-ratio: ${slides[0].width} / ${slides[0].height}`}
>
    <Image
        src={slides[0]}
        alt="Showcased screenshot of Panorama Tab"
        class="crossfade-img is-active"
        loading="eager"
    />
    <Image
        src={slides[0]}
        alt="Showcased screenshot of Panorama Tab"
        class="crossfade-img"
        loading="eager"
    />
</div>
<div class="thumbnails">
    {slides.map((slide) => (
        <Image src={slide} class="slide" alt="New Tab Screenshots" />
    ))}
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const showcase = document.querySelector(".showcase") as HTMLElement;
        const layers =
            showcase.querySelectorAll<HTMLImageElement>(".crossfade-img");
        const thumbnails =
            document.querySelectorAll<HTMLImageElement>(".slide");

        // warm the cache so a transition never shows a blank frame
        thumbnails.forEach((thumb) => {
            const preload = new Image();
            preload.src = thumb.src;
        });

        let activeLayer = 0;
        let currentIndex = 0;
        const totalImages = thumbnails.length;
        const intervalTime = 6000;

        const changeImage = (imageSrc: string) => {
            const nextLayer = activeLayer === 0 ? 1 : 0;
            const incoming = layers[nextLayer];
            const outgoing = layers[activeLayer];

            incoming.src = imageSrc;
            incoming.classList.add("is-active");
            outgoing.classList.remove("is-active");

            activeLayer = nextLayer;
        };

        const showNextImage = () => {
            currentIndex = (currentIndex + 1) % totalImages;
            const nextImage = thumbnails[currentIndex];
            if (nextImage && nextImage.src) {
                changeImage(nextImage.src);
            }
        };

        let slideshowInterval = setInterval(showNextImage, intervalTime);

        showcase.addEventListener("click", function () {
            clearInterval(slideshowInterval);
            showNextImage();
            slideshowInterval = setInterval(showNextImage, intervalTime);
        });

        thumbnails.forEach(function (thumb, index) {
            thumb.addEventListener("click", function (event) {
                clearInterval(slideshowInterval);
                const target = event.target as HTMLImageElement;
                if (target && target.src) {
                    changeImage(target.src);
                    currentIndex = index;
                }
                slideshowInterval = setInterval(
                    showNextImage,
                    intervalTime * 1.7,
                );
            });
        });
    });
</script>

<style>
    .showcase {
        position: relative;
        width: 100%;
        cursor: pointer;
        filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.6));
    }
    .crossfade-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        transition: opacity 500ms ease;
    }
    .crossfade-img.is-active {
        opacity: 1;
    }
    .thumbnails {
        padding-top: 12px;
        padding-bottom: 24px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }
    .slide {
        transition: all 150ms linear;
    }
    .slide:hover {
        opacity: 0.8;
    }
    img {
        cursor: pointer;
        border-radius: 4px;
    }
</style>
