---
import { Image } from "astro:assets";
import chrome from "../assets/chrome.svg";
import firefox from "../assets/firefox.svg";
import edge from "../assets/edge.svg";
---

<section class="column-wrapper">
  <p>Available on</p>
  <div class="row-wrapper links">
    <a
      href="https://chrome.google.com/webstore/detail/panorama-tab/einjlbiknhpkccefknpcnmnmmnhigcbc"
    >
      <Image alt="Chrome Browser Logo" src={chrome} loading="eager" />
    </a>
    <a
      href="https://microsoftedge.microsoft.com/addons/detail/panorama-tab/pfpebaokeeiinfhcklkomfbdejpfaoke"
    >
      <Image alt="Firefox Browser Logo" src={firefox} loading="eager" />
    </a>
    <a href="https://addons.mozilla.org/addon/panorama-tab/">
      <Image alt="Edge Browser Logo" src={edge} loading="eager" />
    </a>
  </div>
</section>

<style>
  section {
    width: fit-content;
  }

  a img {
    transition: transform 150ms ease-out;
  }

  a:hover img {
    transform: scale(1.1);
  }

  img {
    height: 44px;
    width: 44px;
    filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.2));
  }

  .links {
    gap: 12px;
  }

  .column-wrapper {
    align-items: center;
    gap: 4px;
  }

  p {
    cursor: default;
    font-size: 0.8rem;
    opacity: 0.8;
  }
</style>
