---
import Layout from "../layouts/Layout.astro";
import Slideshow from "../components/Slideshow.astro";
import GetButton from "../components/GetButton.astro";
import OpenSource from "../components/OpenSource.astro";
import Logo from "../components/Logo.astro";
---

<Layout>
    <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title" class="hero__title">
            Your new tab.
            <br />
            <span>Simple. Beautiful.</span>
        </h1>

        <p class="hero__tagline">
            Replace your browser's default new tab page with something calmer,
            designed to fit your style, with a simple summary of the day for
            your location and beautiful, customizable backgrounds.
        </p>

        <GetButton />
    </section>

    <Slideshow />

    <section class="features" aria-labelledby="features-title">
        <div class="section-heading">
            <h2 id="features-title">
                Basic features.
                <br />
                No distractions.
            </h2>
        </div>
        <div class="feature-grid">
            <article class="feature-card">
                <span class="feature-mark" aria-hidden="true">
                    Holidays
                </span>
                <h3>Your day, at a glance.</h3>
                <p>
                    Today's date, with today's holiday or the next one to look
                    forward to.
                </p>
            </article>
            <article class="feature-card">
                <span class="feature-mark" aria-hidden="true">
                    Greetings
                </span>
                <h3>A little hello, just for you.</h3>
                <p>
                    A friendly greeting every time you open a new tab. Add your
                    name in settings for a more personal welcome.
                </p>
            </article>
            <article class="feature-card">
                <span class="feature-mark" aria-hidden="true">
                    Time
                </span>
                <h3>A moment to check the time.</h3>
                <p>
                    The current time, paired with a little analog clock that
                    keeps time right alongside it.
                </p>
            </article>
            <article class="feature-card">
                <span class="feature-mark" aria-hidden="true">
                    Weather
                </span>
                <h3>A quick look outside.</h3>
                <p>
                    The current temperature, and a short summary. From clear
                    skies to clouds, know what it's like outside.
                </p>
            </article>
            <article class="feature-card">
                <span class="feature-mark" aria-hidden="true">
                    Backgrounds
                </span>
                <h3>Set your own scene.</h3>
                <p>
                    Make your tab feel like yours with photos from Unsplash,
                    solid colors, or gradients. Pick what suits your mood.
                </p>
            </article>
            <article class="feature-card">
                <span class="feature-mark" aria-hidden="true">
                    Privacy
                </span>
                <h3>Your tab. Your business.</h3>
                <p>
                    Free and open source, with no account or premium tier. Your
                    settings stay on your device, right where they belong.
                </p>
            </article>
        </div>
    </section>

    <OpenSource />
</Layout>

<style>
    .hero__title span {
        color: var(--color-text-muted);
    }

    .features {
        padding-block: clamp(5rem, 10vw, 9rem);
    }
    .section-heading {
        text-align: center;
        margin-bottom: 3rem;
    }
    .section-heading h2 {
        margin-block: 1rem 1.25rem;
        font-size: clamp(2rem, 4.5vw, 3.75rem);
        line-height: 1.1;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }
    .feature-card {
        --feature-color: var(--color-brand-pink);

        padding: clamp(1.5rem, 3vw, 2.5rem);
        border: 1px solid var(--color-border);
        border-radius: 1.5rem;
        background: linear-gradient(145deg, var(--color-surface), transparent);
        text-align: center;
    }
    .feature-card:nth-child(3n + 2) {
        --feature-color: var(--color-brand-yellow);
    }
    .feature-card:nth-child(3n) {
        --feature-color: var(--color-brand-cyan);
    }
    .feature-mark {
        display: inline-block;
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-full);
        background: var(--feature-color);
        color: var(--color-on-brand);
        font-weight: var(--fw-bold);
        font-size: 0.68rem;
        letter-spacing: 0.04em;
        padding-top: calc(var(--space-1) + 1.5px);
        text-transform: uppercase;
    }
    .feature-card h3 {
        font-size: 1.3rem;
        margin-block: 2rem 1rem;
    }
    .feature-card p {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.75;
    }
    @media (max-width: 48rem) {
        .feature-grid {
            grid-template-columns: 1fr;
        }
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-6);

        width: 100%;
        margin-inline: auto;
        padding-top: clamp(2rem, 5vw, 4rem);
        margin-bottom: clamp(3.5rem, 7vw, 6rem);
        text-align: center;
    }

    .hero__title {
        max-width: 18ch;
        font-size: clamp(2.65rem, 7.8vw, 6.5rem);
        letter-spacing: -0.065em;
        line-height: 1.03;
    }

    .hero__tagline {
        max-width: 49ch;

        color: var(--color-text-muted);
        font-size: clamp(1.05rem, 2vw, 1.2rem);
        line-height: 1.5;
    }

    @media (max-width: 30rem) {
        .hero__title {
            max-width: none;
        }

        .hero__tagline {
            font-size: var(--fs-base);
        }
    }
</style>
