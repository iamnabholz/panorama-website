---
import Layout from "../layouts/Layout.astro";
import Slideshow from "../components/Slideshow.astro";
import GetButton from "../components/GetButton.astro";
import Logo from "../components/Logo.astro";
import { Image } from "astro:assets";
---

<Layout>
    <section class="hero">
        <a href="/" class="row name">
            <Logo />
            <span style="margin-top: 4px;">Panorama Tab</span>
        </a>
        <br />
        <br />
        <h1>
            Your new tab.
            <br />
            Simple. Beautiful.
        </h1>
        <p class="dek muted">
            Swap your browsers default new tab page for something calmer and
            built to fit your style, with a simple summary of the day for your
            location, and beautiful customizable backgrounds.
        </p>
        <GetButton />
    </section>

    <Slideshow />

    <section class="row support-section">
        <a
            href="https://www.producthunt.com/products/panorama-tab/reviews/new?utm_source=badge-product_review&utm_medium=badge&utm_source=badge-panorama-tab"
            target="_blank"
            class="badge-link"
        >
            <Image
                src="https://api.producthunt.com/widgets/embed-image/v1/product_review.svg?product_id=499769&theme=light"
                alt="Panorama Tab - New tab you'll open just to see what today looks like | Product Hunt"
                style="width: 250px; height: 54px;"
                width="250"
                height="54"
            />
        </a>
        <a
            href="https://www.buymeacoffee.com/nabholz"
            target="_blank"
            class="badge-link"
        >
            <Image
                src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png"
                alt="Buy Me A Coffee"
                width="217"
                height="60"
                style="width: 250px; height: 54px;"
            />
        </a>
    </section>

    <footer class="row">
        <a href="/">Panorama Tab</a>
        <a href="https://app.notion.com/p/nabholz/Panorama-Tab-Privacy-Policy-3cc1169905be80589a79cdba1840f806">
            Privacy Policy
        </a>
        <a href="https://nabholz.work">Lukas Nabholz</a>
    </footer>
</Layout>

<style>
    .name {
        gap: 10px;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .hero {
        max-width: var(--max-width);
        margin: 10vh auto 7vh;
        text-align: left;
    }

    .hero h1 {
        font-size: clamp(2.75rem, 7vw, 4.5rem);
        margin-bottom: 1.25rem;
    }

    .hero h1 br {
        display: block;
    }

    .dek {
        font-size: 1.2rem;
        line-height: 1.5;
        max-width: 42ch;
        margin-bottom: 2rem;
    }

    .support-section {
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 6vh 0 4vh;
    }

    .badge-link :global(img) {
        object-fit: contain;
    }

    footer {
        justify-content: space-between;
        font-size: 0.9rem;
        margin-top: 3rem;
        padding: 1.5rem 0 3rem;
        border-top: 1px solid var(--border-color);
        color: var(--text-muted);
    }

    footer a:hover {
        color: var(--text-color);
    }

    @media only screen and (max-width: 640px) {
        .hero {
            text-align: left;
        }

        .support-section {
            flex-direction: column;
            gap: 1rem;
            padding: 4vh 0 2vh;
        }

        footer {
            flex-direction: column;
            gap: 12px;
        }
    }
</style>
