---
import Layout from "../layouts/Layout.astro";
import Slideshow from "../components/Slideshow.astro";
import GetButton from "../components/GetButton.astro";
import Logo from "../components/Logo.astro";
import OpenSource from "../components/OpenSource.astro";
---

<Layout>
    <section class="hero">
        <a href="/" class="row name">
            <Logo />
            <span style="margin-top: 4px;">Panorama Tab</span>
        </a>
        <br />
        <br />
        <h1>
            Your new tab.
            <br />
            Simple. Beautiful.
        </h1>
        <p class="dek muted">
            Swap your browsers default new tab page for something calmer and
            built to fit your style, with a simple summary of the day for your
            location, and beautiful customizable backgrounds.
        </p>

        <div class="row trust-row muted">
            <span>Free</span>
            <span aria-hidden="true">·</span>
            <span>Open Source</span>
            <span aria-hidden="true">·</span>
            <span>Private</span>
        </div>

        <GetButton />
    </section>

    <Slideshow />

    <OpenSource />

    <section class="stack credits">
        <span>
            Built by{" "}
            <a href="https://nabholz.work/" target="_blank">
                Lukas Nabholz
            </a>
        </span>
        <span>
            Help keep it going,{" "}
            <a href="https://www.buymeacoffee.com/nabholz" target="_blank">
                Buy me a coffee
            </a>
        </span>
    </section>
</Layout>

<style>
    .name {
        gap: 10px;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .hero {
        max-width: var(--max-width);
        margin: 10vh auto 7vh;
        text-align: left;
    }

    .hero h1 {
        font-size: clamp(2.75rem, 7vw, 4.5rem);
        margin-bottom: 1.25rem;
    }

    .hero h1 br {
        display: block;
    }

    .trust-row {
        gap: 10px;
        font-size: 0.9rem;
        margin: 2rem 0;
        font-weight: bold;
    }

    .dek {
        font-size: 1.2rem;
        line-height: 1.5;
        max-width: 42ch;
    }

    .badge-link :global(img) {
        object-fit: contain;
    }

    .credits {
        max-width: var(--max-width);
        margin: 0 auto 16vh;
        text-align: left;
        gap: 1rem;
    }

    .credits a {
        text-decoration: underline;
        text-decoration-color: var(--border-color);
        text-underline-offset: 4px;
        transition: text-decoration-color 150ms linear;
    }

    .credits a:hover {
        color: var(--text-color);
        text-decoration-color: currentColor;
    }
</style>
