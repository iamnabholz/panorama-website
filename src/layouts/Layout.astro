---
import "../global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Panorama Tab - Browser extension to replace your new tab"
        />
        <meta
            name="keywords"
            content="Browser, New Tab, Weather, Information, Holidays, Extension, Productivity"
        />
        <meta name="author" content="Lukas Nabholz" />
        <meta property="og:title" content="Panorama Tab" />
        <meta
            property="og:description"
            content="Browser extension to replace your new tab"
        />
        <meta
            property="og:image"
            content="https://panoramatab.netlify.app/big_cover.png"
        />
        <meta property="og:url" content="https://panoramatab.netlify.app/" />
        <meta property="og:type" content="website" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Panorama Tab - New tab browser extension</title>
    </head>
    <body>
        <main>
            <slot />
        </main>
    </body>
</html>

<style>
    main {
        margin: auto;
        width: 1100px;
        max-width: calc(100% - 2.5rem);
    }
</style>
