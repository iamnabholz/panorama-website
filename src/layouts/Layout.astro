---
import Logo from "../components/Logo.astro";
import "../global.css";

const SITE_TITLE = "Panorama Tab — Your new tab. Simple. Beautiful.";
const SITE_DESCRIPTION =
    "Panorama Tab is a calmer, customizable browser new tab page with useful daily information and beautiful backgrounds.";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <meta name="description" content={SITE_DESCRIPTION} />
        <meta name="author" content="Lukas Nabholz" />
        <meta name="generator" content={Astro.generator} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={SITE_TITLE} />
        <meta property="og:description" content={SITE_DESCRIPTION} />
        <meta
            property="og:image"
            content="https://panoramatab.netlify.app/big_cover.png"
        />
        <meta property="og:url" content="https://panoramatab.netlify.app/" />
        <meta property="og:site_name" content="Panorama Tab" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={SITE_TITLE} />
        <meta name="twitter:description" content={SITE_DESCRIPTION} />
        <meta
            name="twitter:image"
            content="https://panoramatab.netlify.app/big_cover.png"
        />

        <meta name="theme-color" content="#FFD400" />

        <link rel="icon" href="/icon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <title>{SITE_TITLE}</title>
    </head>

    <body>
        <header class="site-header">
            <div class="site-brand">
                <span class="site-brand__icon" aria-hidden="true">
                    <Logo />
                </span>
                <div class="site-brand__copy" style="margin-top: 0.2rem">
                    <span class="site-brand__name">Panorama Tab</span>
                    <a class="site-brand__author" href="https://nabholz.work/">
                        by Lukas Nabholz
                    </a>
                </div>
            </div>

            <nav aria-label="Header">
                <a
                    class="header-link"
                    href="https://github.com/iamnabholz/panorama-extension"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Panorama Tab on GitHub"
                >
                    <svg
                        height="24px"
                        width="24px"
                        role="img"
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                    >
                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                    </svg>

                    <span style="margin-top: 0.2rem">GitHub</span>
                </a>
            </nav>
        </header>
        <main id="main-content" class="site-main">
            <slot />
        </main>

        <footer class="site-footer">
            <nav class="site-footer__nav" aria-label="Footer">
                <a
                    target="_blank"
                    rel="noopener noreferrer"
                    href="https://app.notion.com/p/nabholz/Panorama-Tab-Privacy-Policy-3cc1169905be80589a79cdba1840f806"
                >
                    Privacy policy
                </a>

                <a
                    href="https://github.com/iamnabholz/panorama-extension"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    GitHub
                </a>

                <a
                    href="https://www.producthunt.com/products/panorama-tab"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Product Hunt
                </a>

                <a
                    href="https://www.buymeacoffee.com/nabholz"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    BuyMeACoffee
                </a>
            </nav>
        </footer>
    </body>
</html>

<style>
    .site-header {
        position: fixed;
        top: max(2rem, env(safe-area-inset-top));
        inset-inline: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.625rem 1.3rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-full);
        color: var(--color-text);
        background: var(--color-surface);
        box-shadow: 0 0.5rem 2rem rgb(0 0 0 / 0.12);
    }

    @supports (backdrop-filter: blur(16px)) {
        .site-header {
            background: color-mix(
                in srgb,
                var(--color-surface) 90%,
                transparent
            );
            backdrop-filter: blur(16px);
        }
    }

    .site-brand {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        min-width: 0;
    }

    .site-brand__icon {
        flex-shrink: 0;
        transform: scale(1.5);
    }
    .site-brand__copy {
        display: grid;
    }
    .site-brand__name {
        font-size: clamp(0.875rem, 2vw, 1rem);
        font-weight: var(--fw-semibold);
        line-height: 1;
    }

    .site-brand__author {
        display: inline-flex;
        align-items: center;
        color: var(--color-text-muted);
        font-size: 0.75rem;
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .site-brand__author:hover {
        color: var(--color-text);
    }
    .site-header nav {
        flex-shrink: 0;
    }
    .header-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        min-height: 2.75rem;
        padding: 0.625rem 1rem;
        border-radius: var(--radius-full);
        font-size: 0.8rem;
        text-decoration: none;
        transition: border-color var(--duration-fast);
    }
    .header-link:hover {
        border-color: var(--color-text-muted);
    }
    :global(html) {
        scroll-padding-top: 7rem;
    }

    .site-main,
    .site-footer {
        width: min(var(--content-width), calc(100% - (var(--page-gutter) * 2)));
        margin-inline: auto;
    }

    .site-header {
        width: min(
            calc(var(--content-width) - 20%),
            calc(100% - (var(--page-gutter) * 2))
        );
        margin-inline: auto;
    }

    .site-footer {
        padding-block: 2.5rem 3rem;
    }

    .site-footer nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem 2rem;
        text-align: center;
        font-size: 0.8rem;
    }

    .site-main {
        flex: 1;
        padding-top: calc(6.75rem + env(safe-area-inset-top, 0px));
    }

    .site-footer a {
        color: inherit;
        text-decoration-color: var(--color-border-strong);

        transition:
            color var(--duration-fast) linear,
            text-decoration-color var(--duration-fast) linear;
    }

    .site-footer a:hover {
        color: var(--color-text);
        text-decoration-color: currentColor;
    }

    @media (prefers-reduced-motion: no-preference) {
        .site-main {
            animation: site-enter 600ms var(--ease-standard) 120ms both;
        }
    }

    @keyframes site-enter {
        from {
            opacity: 0;
            transform: translateY(2rem) scale(0.96);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media (max-width: 40rem) {
        .site-footer {
            flex-direction: column;
            align-items: center;
        }
    }
</style>
